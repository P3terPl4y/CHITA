[Unit]
Description=CHITA local Go backend and React client
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/CHITA
ExecStart=%h/CHITA/storage/bin/chita
Environment=APP_ENV=local
Environment=APP_HOST=127.0.0.1
Environment=APP_PORT=3330
Environment=HALCON_URL=http://127.0.0.1:3300
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
TimeoutStopSec=15

[Install]
WantedBy=default.target
